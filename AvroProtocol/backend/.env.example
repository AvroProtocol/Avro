NODE_ENV=development
PORT=3001
DATABASE_URL=
DATABASE_PASSWORD=
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SHARD_B_ENCRYPTION_KEY=
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
JWT_SECRET=
ENTRY_POINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
PAYMASTER_ADDRESS=None
CORS_ALLOWED_ORIGINS=https://avroprotocol.com,https://www.avroprotocol.com
PUBLIC_APP_URL=https://avroprotocol.com
BUNDLER_RPC_URL=

# --- Cross-chain bridge rebates (Relay) ---
RELAY_API_URL=https://api.relay.link
# Share of the relayer spread rebated to the user, in basis points (2500 = 25%).
BRIDGE_REBATE_BPS=2500
# Avro's own fee on each bridge route, in bps. Accrues with Relay and funds
# the rebate pool; claimable via Relay's /app-fees/{wallet}/claim.
BRIDGE_APP_FEE_BPS=0
BRIDGE_APP_FEE_RECIPIENT=
# Minimum claimable balance in micro-USD (1000000 = $1.00).
BRIDGE_MIN_CLAIM_MICROS=1000000
# --- AVRO pricing ---
# Configure AVRO pricing only after the verified token is deployed and liquid.
# Claims can use an operator-set reference price with a maximum allowed spot deviation.
AVRO_USD_REFERENCE_PRICE=
AVRO_PRICE_MAX_DEVIATION_BPS=2000
# Optional hard pin. When set, this price is used and spot is ignored entirely.
AVRO_USD_PRICE=

# --- Treasury payouts ---
# Rebates are paid from a pre-funded AVRO balance rather than market-buying per claim.
# Payouts stay simulated (dry run) unless this is exactly "true".
REBATE_PAYOUTS_ENABLED=false
# Rebates settle from the platform pool wallet - the same wallet that custodies
# staked AVRO and pays gas sponsorship. Staked AVRO is treated as a reserve that
# rebate payouts may never draw against.
PLATFORM_POOL_WALLET_PUBLIC_KEY=0xf5370a080A8c8Eed95E71982b228A3C0BdEfF41f
# AES-256-GCM encrypted pool key, same scheme as Shard B. The plaintext
# PLATFORM_POOL_WALLET_PRIVATE_KEY is refused when NODE_ENV=production.
PLATFORM_POOL_WALLET_PRIVATE_KEY_ENCRYPTED=
PLATFORM_POOL_WALLET_PRIVATE_KEY=
# AVRO (Avro), 18 decimals, Robinhood Chain. NOT the USDG contract.
AVRO_TOKEN_ADDRESS=
# Per-claim ceiling in AVRO wei, and per-run claim count.
REBATE_MAX_PAYOUT_WEI=10000000000000000000000000
REBATE_MAX_PAYOUTS_PER_RUN=25
# Bearer token for POST /v1/bridge/payouts/run. Unset disables the endpoint.
REBATE_ADMIN_TOKEN=
