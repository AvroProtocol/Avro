# Frontend Environment Variables
VITE_API_URL=https://api.avroprotocol.com
VITE_BACKEND_URL=https://api.avroprotocol.com
VITE_ROBINHOOD_CHAIN_ID=
VITE_ROBINHOOD_RPC_URL=
VITE_AVRO_TOKEN_ADDRESS=

# Canonical origin, no trailing slash (e.g. https://avroprotocol.com).
# Used to build absolute og:image / og:url values — X, Slack, Discord and
# LinkedIn ignore relative image paths, so share cards render without an
# image until this is set. Set it per environment (prod, preview, local).
VITE_SITE_URL=https://avroprotocol.com

# Optional release fallback used only when GitHub release discovery is unavailable
APP_RELEASE_TAG=v0.1.14
